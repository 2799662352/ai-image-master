#!/usr/bin/env bash
# Codex SessionStart hook for catimation-core plugin.
set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 核心集成已启用。\n\n【先判断:是不是纯文本任务】写文案、写剧本、整理文件、改一段文字、列清单——这些**不加载任何 skill**,直接做完交付。用户说「快点」「简单弄一下」时同理。\n\n【出图时】用 generate_image / generate_images(渲染进聊天并落盘+历史),多张用后者一次批量。分级与七字段提示词骨架都在 catimation-image 入口卡里,**骨架已内联,别再去读 director-prompt-engineering**(够用的任务读它只是多一次文件读)。\n\n【其余一律用到才载】画面里有需要跨图复用的人物时,才载角色链(director-anchor-extraction-quality / director-character-consistency)与 catimation-portrait-library;写非常规机位或运镜时才查 search_cinematography_kb,常规景别(medium shot, eye-level)不查,同一任务里查过的直接复用。对症技法按症状挑,不预加载。\n\n【交互弹窗】准备列 2 个以上选项/方案,或遇到该由用户拍板的决策(景别/风格/运镜/模型/下一步…),直接调 ask_user 渲染可点击选项卡,别只发纯文字编号列表。开放或高价值的创意方向可走 /brainstorm。\n\n命令:/gen-image 出图,/brainstorm 头脑风暴。\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
exit 0
