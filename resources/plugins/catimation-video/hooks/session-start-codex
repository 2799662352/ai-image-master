#!/usr/bin/env bash
# Codex SessionStart hook for catimation-video plugin.
# Injects a compact pointer to the single video entry (catimation-video) and
# its tiered execution model. Skill bodies are loaded on demand via the Skill
# tool — never inlined here.
# Codex variant: always emits nested hookSpecificOutput.additionalContext.

set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 视频出片插件已启用。\n\n视频生成的唯一顶层入口是 catimation-video 技能:接到出视频请求先用 Skill 工具加载它,由它把任务分成 快速/标准/专业/制片 四级,再决定加载哪些下游技能——快速任务(单镜、让图动起来)只需 catimation-video + sd2-pe,不要预加载其它技能。视频相关任务(出片/写·改·优化视频提示词/Seedance 语法问答)自动加载 sd2-pe,不需用户点名。仅简单单镜轻量任务走路径A,可跳过 seedance-cinematic-format;复杂、多镜、混合媒介或需展开导演/作品参考任一命中即走路径B并加载该叶子,B条件优先于任务类型。两条路径都覆盖八大核心要素、12项内容和五大必备块;标题、分段与散文形式自由,分流只减结构开销、不漏交付内容。写导演参考前主动检索核实2-3个真实影视参考候选给用户选;真人、2D、3D是可组合profile,电影是检索意图词;台词语言按用户要求或原文,不擅自翻译。禁止脱离skill和素材凭记忆硬写。命令:/sd2优化提示词,/gen-video出片,/edit-video后期。\n\n【角色片/多镜硬门(纲要,完整规则见 catimation-video 正文)】视频里有反复出现的角色、或不止一个镜头时:1) 每个复用角色先定 identity-hard 主锚(大头+全身/三四多视图/其它确认资产均可;用户已指定即用,多套拿不准才问);2) 多镜先排故事板给用户过;3) 资产齐备才开始渲染——两条出片面同一口径:generate_video 与 video_workbench_start 都受这道门约束,工作台不是例外(它天生就是多镜场景);缺口先找现成、可自补的用 generate_image 补、身份关键的才问用户;4) 生成时用上全部可用素材(图片/参考视频/音频),有素材却纯文字=错;5) 工作台上一张卡=一次生成=一个镜头,多镜拆成多张卡共用同一套锚点,别把「镜头1…镜头2…」挤进同一张卡。用户手里已有剧本/分镜表/制片包要铺满工作台时,走 storyboard-to-workbench。\n\n出片后 QA 按风险分级(快速/视觉/内容/发布),分级规则在 catimation-video 正文;抽帧九宫格与剪辑拼接/加字幕/水印/混音/变速按需加载 ffmpeg-win,内容理解/审片按需加载 catimation-understand(understand_video)。\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
