#!/usr/bin/env bash
# Codex SessionStart hook for catimation-video plugin.
# Injects a compact pointer to the single video entry (catimation-video) and
# its tiered execution model. Skill bodies are loaded on demand via the Skill
# tool — never inlined here.
# Codex variant: always emits nested hookSpecificOutput.additionalContext.

set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 视频出片插件已启用。\n\n视频生成的唯一顶层入口是 catimation-video 技能:接到出视频请求先用 Skill 工具加载它,由它把任务分成 快速/标准/专业/制片 四级,再决定加载哪些下游技能——快速任务(单镜、让图动起来)只需 catimation-video + sd2-pe,不要预加载其它技能。视频相关任务(出片/写·改·优化视频提示词/Seedance 语法问答)自动加载 sd2-pe,不需用户点名。产出会跨镜/跨图连续时(不止一个镜头、一板卡片、一个系列、同一角色跨多张图,或用户给了剧本/分场/镜头清单)同样自动加载 shotlist-builder,也不需点名「分镜表」——它管镜头行怎么切、哪几行合成一条4-15s提示词、要不要出一张可搜索的HTML总表;用户没有剧本时由它主动问出镜头表(讲什么/几镜/谁反复出现/规格),不要等用户递本子。这两个是底座,不占分级表的自选技法名额。仅简单单镜轻量任务走路径A,可跳过 seedance-cinematic-format;复杂、多镜、混合媒介或需展开导演/作品参考任一命中即走路径B并加载该叶子,B条件优先于任务类型。两条路径都覆盖八大核心要素、12项内容和五大必备块;标题、分段与散文形式自由,分流只减结构开销、不漏交付内容。写导演参考前主动检索核实2-3个真实影视参考候选给用户选;真人、2D、3D是可组合profile,电影是检索意图词;台词语言按用户要求或原文,不擅自翻译。禁止脱离skill和素材凭记忆硬写。命令:/sd2优化提示词,/gen-video出片,/edit-video后期。\n\n【角色片/多镜硬门(纲要,完整规则见 catimation-video 正文)】视频里有反复出现的角色、或不止一个镜头时:1) 每个复用角色先定 identity-hard 主锚(大头+全身/三四多视图/其它确认资产均可;用户已指定即用,多套拿不准才问);2) 多镜先排故事板给用户过;3) 资产齐备才开始渲染——两条出片面同一口径:generate_video 与 video_workbench_start 都受这道门约束,工作台不是例外(它天生就是多镜场景);缺口先去人像库找现成(catimation-portrait-library)、可自补的用 generate_image 补、身份关键的才问用户;4) 生成时用上全部可用素材(图片/参考视频/音频),有素材却纯文字=错;5) 工作台上一张卡=一次生成=一个连续节拍(4-15s):同场景连着演完的几镜可按 sd2-pe 路径 B 合成一段镜头流程放同一张卡,要独立重跑/各镜素材不同/时长超了/跨场景才拆卡;拆开的多张卡共用同一套锚点。工作台上的建卡/整板/字段映射交 catimation-video-workbench。**用户催促、赶时间、说「直接开跑」都不构成跳过这道门的理由**——多镜漂脸要重跑全部卡片,补门比返工快,把这笔账算给用户听。\n\n出片后 QA 按风险分级(快速/视觉/内容/发布),分级规则在 catimation-video 正文;抽帧九宫格与剪辑拼接/加字幕/水印/混音/变速按需加载 ffmpeg-win,内容理解/审片按需加载 catimation-understand(understand_video)。\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
