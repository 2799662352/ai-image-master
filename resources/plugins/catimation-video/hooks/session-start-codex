#!/usr/bin/env bash
# Codex SessionStart hook for catimation-video plugin.
# Injects a compact pointer to the single video entry (catimation-video) and
# its tiered execution model. Skill bodies are loaded on demand via the Skill
# tool — never inlined here.
# Codex variant: always emits nested hookSpecificOutput.additionalContext.

set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 视频出片插件已启用。\n\n视频生成的唯一顶层入口是 catimation-video 技能:接到出视频请求先用 Skill 工具加载它,由它把任务分成 快速/标准/专业/制片 四级,再决定加载哪些下游技能——快速任务(单镜、让图动起来)只需 catimation-video + sd2-pe,不要预加载其它技能。写视频提示词前用 Skill 工具加载 sd2-pe(Seedance 2.0 提示词底座:八大要素/路径A·B/多模态素材绑定),禁止脱离 skill 和素材凭记忆硬写。命令:/sd2 优化提示词,/gen-video 出片,/edit-video 后期。\n\n【角色片/多镜硬门(纲要,完整规则见 catimation-video 正文)】视频里有反复出现的角色、或不止一个镜头时:1) 每个出镜角色先建人物卡(大头照+全身照)入人像库作唯一身份锚;2) 多镜先排故事板给用户过;3) 资产齐备才 generate_video——缺口先找现成、可自补的用 generate_image 补、身份关键的才问用户;4) 生成时用上全部可用素材(图片/参考视频/音频),有素材却纯文字=错。\n\n出片后 QA 按风险分级(快速/视觉/内容/发布),分级规则在 catimation-video 正文;抽帧九宫格与剪辑拼接按需加载 ffmpeg-win,内容理解/审片按需加载 catimation-understand(understand_video)。\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
