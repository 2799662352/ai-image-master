#!/usr/bin/env bash
# SessionStart hook for catimation-video plugin.
#
# 这里只放**短指针**：什么时候该去加载入口卡，以及什么时候一个都不要加载。
# 具体纪律（分级表、角色片硬门、素材上限、QA 分档）全在 catimation-video 正文里，
# 用 Skill 工具按需读 —— 那才是渐进披露的意思。
#
# 历史教训：这段注入曾经膨胀到约 1900 字符，把「自动加载 sd2-pe + sd25-pe」
# 「多镜硬门五条」这类正文内容提前塞进每一轮会话。结果是拆个脚本、改条提示词都要
# 先过一遍分级和闸门，三分钟的事拖成几小时。注入越长，模型越倾向把它当成
# 「每次都要照做的清单」，而不是「需要时去查的索引」。

set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 视频出片插件已启用。\n\n【先判断:是不是纯文本任务】写剧本、拆脚本、拆批次、整理文件、列镜头清单、改一段文字——这些**不加载任何 skill**,直接做完交付。它们是几分钟的事,不要套分级、不要走确认闸门、不要预读提示词底座。用户说「快点」「简单弄一下」时同理。\n\n【真要出视频时】才用 Skill 工具加载 catimation-video 入口,由它分级(快速/标准/专业/制片)并决定还要不要加载下游。写视频提示词时按 model 载**一个**底座:2.5(默认)→ sd25-pe;2.0 家族 → sd2-pe;万相 3.0(wan3)→ wan3-cinematic-30s。**同一任务只载一个、全程复用,多载是纯浪费**(模板只能套一套;万相的产品/情绪专项叶子由底座按题材引出)。分镜表、对症技法、QA、后期工具一律**用到才载**,不预加载。\n\n命令:/sd25-pe 优化提示词,/gen-video 出片,/edit-video 后期。\n</IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
