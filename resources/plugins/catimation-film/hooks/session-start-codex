#!/usr/bin/env bash
# Codex SessionStart hook for catimation-film plugin.
set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 制片编排器已启用。当用户要「做电影/做短片/一条龙/从剧本到成片」时,用 Skill 工具加载 film-studio 总编排器,按 G0→G8 门控流水线推进(概念→剧本→分镜→设定→出图→图生视频→配音→拼接→交付),绝不跳门;每镜出图/出视频委托 catimation-image / catimation-video 唯一入口按级执行,复杂镜头设计在专业/制片级按需加载 director-orchestrator。\n【Skill-first】每个 G 阶段先实际加载并使用该阶段相关 Skill,交付时写 skills_used/applied 回执;不能只点名,也不能一次全载。\n\n【角色片/多镜硬门(凡涉 G5 图生视频必守,与 catimation-video 一致)】只要片中有反复出现的角色或不止一个镜头,生成前 MUST 依次:1) 人物卡——每个复用角色先定 identity-hard 主锚(大头+全身/三四多视图/其它确认资产均可;用户已指定即用,多套拿不准才问),存人像库 asset:// 全片复用;2) 故事板/分镜——非单镜先排 镜头1/2/…(运镜→主体动作/表情→位置/空间→音频),给用户过一遍再生成;3) 资产齐备门(硬)——备齐才出视频,缺资产先报缺口清单,按「先找库存→非身份关键自主补图→身份/意图关键才问用户」三选一处理,绝不先生成再补;两条出片面同一口径:generate_video 与 video_workbench_start 都受这道门约束,且工作台上一张卡=一个镜头,多镜拆多卡共用同一套锚点;4) 用上全部可用素材(图/参考视频/音频),一镜一专属夹;5) 写视频 prompt 前先用 sd2-pe 工程化(物理参数优先)+ storyboard-* 逐镜打磨,禁止脱离 skill+素材凭记忆硬写。轻量例外:单图「让它动起来」一次性请求,直接把该图当首帧动起来即可,不必强排人物卡/故事板。\n命令:/make-film 端到端制片,/write-script 写剧本,/trailer 预告片方案。\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
exit 0
