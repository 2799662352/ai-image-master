#!/usr/bin/env bash
# SessionStart hook for catimation-storyboard-pro plugin (generic: cursor/claude/copilot).
set -euo pipefail

session_context="<IMPORTANT>\nCATIMATION 制片包生成器(catimation-storyboard-pro)已启用。\n\n【先判断:是不是纯文本任务】写剧本、拆脚本、拆批次、整理文件、列镜头清单、把已有分镜换个格式——这些**不加载任何 skill**,直接拆完交付。四阶段对表闸门(交对照表→等确认→锁范围→再写提示词)是给**真要开拍的多镜项目**用的;套在「拆个脚本」上会把三分钟的事拖成几小时往返。用户说「快点」「简单弄一下」时同理。**拿不准就先按不加载做**,不够正式再升级。\n\n【要做成多镜片子时】才加载 shotlist-builder:逐镜拆解、决定每镜多长、哪几拍合成一次 4–15s、出一张可搜索筛选的单文件 HTML 生产表。剧本连同一批图/图片文件夹一起进来时,先出素材↔剧本对照表,对不上号不许静默分配;超过 5 张图别逐张看,按 catimation-subagents 并发理解。\n\n【制片包】要连续性受控的完整素材包(角色/场景/道具/风格圣经 + shot cards + 衔接矩阵 + 逐镜提示词 + 剪映清单)时才加载 create-storyboard,由 film-studio 或用户显式触发。\n\n【不加载】纯出图任务——只要关键帧或一组角色图、不做成片时(哪怕给了剧本和整个图片文件夹),交 catimation-image 直接出,跨张一致性由角色链与人像库负责。判据是要不要动起来,不是有没有剧本。\n\n本插件只做规划与交付物,不出图不出片,生成一律交回 catimation-image / catimation-video 入口。命令:/create-storyboard。\n</IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi
exit 0
