# Code Signing Environment Variables
# Copy this file to .env.signing and fill in your values
# DO NOT commit .env.signing to version control!

# ==================== Windows Code Signing ====================
# Path to Windows code signing certificate (.p12 or .pfx file)
# Can be a file path, base64-encoded string, or HTTPS URL
WIN_CSC_LINK=path/to/windows-certificate.p12

# Password for the Windows certificate
WIN_CSC_KEY_PASSWORD=your-windows-certificate-password

# Certificate subject name (required for EV certificates, optional for standard)
# This should match the CN field in your certificate
WIN_CERTIFICATE_SUBJECT_NAME="Your Company Name"

# ==================== macOS Code Signing ====================
# Path to macOS code signing certificate (.p12 file)
# Can be a file path, base64-encoded string, or HTTPS URL
CSC_LINK=path/to/macos-certificate.p12

# Password for the macOS certificate
CSC_KEY_PASSWORD=your-macos-certificate-password

# Optional: Identity name (auto-discovered from keychain if not set)
# CSC_NAME="Developer ID Application: Your Name (TEAMID)"

# ==================== macOS Notarization ====================
# Apple ID for notarization (required for macOS distribution)
APPLE_ID=your-apple-id@example.com

# App-specific password for notarization
# Generate at https://appleid.apple.com/account/manage -> App-Specific Passwords
APPLE_ID_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Apple Developer Team ID (10 character string)
APPLE_TEAM_ID=XXXXXXXXXX

# ==================== GitHub Release ====================
# Personal access token for publishing releases
# Create at https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public)
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== CI/CD Notes ====================
# For CI environments (GitHub Actions, etc.):
# 1. Encode certificates to base64:
#    macOS: base64 -i certificate.p12 -o cert-base64.txt
#    Linux: base64 certificate.p12 > cert-base64.txt
# 2. Store the base64 content as a secret
# 3. Use the secret as CSC_LINK or WIN_CSC_LINK value

# ==================== Optional: S3/CDN Publishing ====================
# AWS credentials for S3 publishing (if using auto-update from S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
