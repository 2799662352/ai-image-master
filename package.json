{
  "name": "catimation-cyberpunk-master",
  "version": "4.7.8",
  "description": "CATIMATION-Cyberpunk Master - AI图片生成桌面应用",
  "main": "dist/main/index.js",
  "author": "CATIMATION",
  "license": "MIT",
  "codexCliVersion": "0.152.1",
  "dockerMcpGatewayVersion": "0.42.1",
  "ffmpegBuildTag": "8.1.1",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "electron",
      "electron-winstaller",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "node scripts/ensure-codex.mjs && node scripts/build-pglite-worker.mjs && electron-vite dev",
    "codex:ensure": "node scripts/ensure-codex.mjs",
    "dev:static": "electron . --dev",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "node scripts/ci/typecheck-baseline.mjs",
    "typecheck:baseline:refresh": "node scripts/ci/typecheck-baseline.mjs --write",
    "build:pglite-worker": "node scripts/build-pglite-worker.mjs",
    "verify:pglite-cap": "node scripts/verify-pglite-cap.mjs",
    "vendor:apiyi-mcp": "node scripts/vendor-apiyi-mcp.mjs",
    "vendor:apiyi-mcp:update": "node scripts/vendor-apiyi-mcp.mjs --update-ref",
    "build:vite": "pnpm run vendor:apiyi-mcp && electron-vite build && node scripts/build-pglite-worker.mjs",
    "build": "pnpm run build:vite && electron-builder",
    "build:win": "pnpm run build:vite && electron-builder --win",
    "build:win64": "pnpm run build:vite && electron-builder --win --x64",
    "build:mac": "pnpm run build:vite && electron-builder --mac",
    "build:linux": "pnpm run build:vite && electron-builder --linux",
    "build:all": "pnpm run build:vite && electron-builder -mwl",
    "build:dir": "pnpm run build:vite && electron-builder --dir",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "install-electron && prisma generate && electron-builder install-app-deps",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --coverage --maxWorkers=4",
    "test:coverage": "vitest run --coverage",
    "test:updater": "vitest run -c vitest.legacy.config.ts tests/main/updater.test.ts",
    "test:workflows": "node --test tests/windows-only-workflows.test.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "release:verify": "node scripts/release/prepare-release.mjs verify",
    "release:cos:dry": "node scripts/release/cos-release.mjs upload-assets --dry-run",
    "pages:generate": "node scripts/release/generate-download-page.mjs",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:stable": "playwright test --project=electron-stable",
    "test:e2e:extended": "playwright test --project=electron-extended",
    "test:e2e:quarantine": "node scripts/release/run-quarantined-e2e.mjs",
    "test:e2e:quarantine:validate": "node scripts/release/validate-e2e-quarantine.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:evals": "vitest run -c vitest.evals.config.ts",
    "test:evals:unit": "vitest run -c vitest.evals.config.ts evals/harness",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "analyze": "electron-vite build -- --mode analyze",
    "analyze:report": "pnpm exec vite-bundle-visualizer",
    "perf:startup": "pnpm exec tsx scripts/measure-startup.ts",
    "pipeline:test": "pnpm exec tsx scripts/run-pipeline-test.ts",
    "bootstrap": "pnpm install && pnpm codex:fetch && pnpm ffmpeg:fetch",
    "codex:fetch": "tsx scripts/fetch-codex.ts",
    "codex:fetch:latest": "tsx scripts/fetch-codex.ts --latest",
    "ffmpeg:fetch": "tsx scripts/fetch-ffmpeg.ts",
    "ffmpeg:fetch:latest": "tsx scripts/fetch-ffmpeg.ts --latest",
    "docker-mcp:fetch": "tsx scripts/fetch-docker-mcp.ts",
    "codex:probe": "tsx scripts/probe-codex.ts",
    "codex:smoke:resume": "tsx scripts/smoke-codex-resume.ts",
    "codex:smoke:compaction": "tsx scripts/smoke-codex-compaction.ts",
    "codex:smoke:claude": "tsx scripts/smoke-claude-bridge.ts",
    "codex:probe:claude": "tsx scripts/probe-gateway-claude.ts",
    "codex:smoke:subagents": "tsx scripts/smoke-subagents.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "agent:init-sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/init.sql",
    "prisma:validate": "prisma validate",
    "test:bench": "vitest bench",
    "test:bench:run": "vitest bench --run",
    "test:bench:ci": "vitest bench --run",
    "publish:marketplace": "node scripts/publish-marketplace.mjs",
    "publish:marketplace:dry": "node scripts/publish-marketplace.mjs --dry-run",
    "publish:marketplace:test": "node --test scripts/lib/marketplace-versioning.test.mjs",
    "test:skill-arch": "node --test scripts/lib/skill-architecture-validator.test.mjs tests/skill-architecture/repository-architecture.test.mjs tests/skill-architecture/prompt-base-and-format.test.mjs",
    "audit:skill-arch": "node scripts/audit-skill-architecture.mjs",
    "skills:gen": "node scripts/generate-first-party-skills.mjs && node scripts/sync-top-level-skills.mjs",
    "skills:gen:check": "node scripts/generate-first-party-skills.mjs --check && node scripts/sync-top-level-skills.mjs --check",
    "publish:skills": "node scripts/upload-skills-to-cos.mjs",
    "publish:skills:dry": "node scripts/upload-skills-to-cos.mjs --dry-run",
    "publish:plugins": "node scripts/upload-plugins-to-cos.mjs",
    "publish:plugins:dry": "node scripts/upload-plugins-to-cos.mjs --dry-run",
    "graph:build": "graphify update . --force",
    "graph:update": "graphify update .",
    "graph:query": "graphify query",
    "graph:explain": "graphify explain",
    "graph:path": "graphify path",
    "graph:hooks": "node scripts/graphify-hooks.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@codeproxy/core": "0.1.22",
    "@electric-sql/pglite": "^0.4.5",
    "@electric-sql/pglite-socket": "^0.1.5",
    "@iarna/toml": "^2.2.5",
    "@langchain/core": "^1.1.40",
    "@langchain/google": "^0.1.3",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.2.10",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/express": "^2.0.0-alpha.2",
    "@modelcontextprotocol/node": "^2.0.0-alpha.2",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@moeru/three-mmd": "0.1.0-beta.3",
    "@monaco-editor/react": "^4.7.0",
    "@parcel/watcher": "^2.5.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@uiw/react-codemirror": "^4.25.9",
    "browser-image-compression": "^2.0.2",
    "choices.js": "^11.1.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "diff": "^9.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "express": "^5.2.1",
    "hono": "^4.12.17",
    "i18next": "^25.8.13",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "langfuse-langchain": "^3.38.6",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.55.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "^19.2.5",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.2.7",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tencentcloud-sdk-nodejs-mps": "^4.1.218",
    "three": "^0.184.0",
    "tldraw": "^5.2.3",
    "toml": "^4.1.1",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^43.2.0",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2799662352/ai-image-master.git"
