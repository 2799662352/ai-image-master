{
  "name": "catimation-cyberpunk-master",
  "version": "4.3.2",
  "description": "CATIMATION-Cyberpunk Master - AI图片生成桌面应用",
  "main": "dist/main/index.js",
  "author": "CATIMATION",
  "license": "MIT",
  "codexCliVersion": "0.130.0",
  "dockerMcpGatewayVersion": "0.42.1",
  "scripts": {
    "dev": "node scripts/build-pglite-worker.mjs && electron-vite dev",
    "dev:static": "electron . --dev",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:pglite-worker": "node scripts/build-pglite-worker.mjs",
    "build:vite": "electron-vite build && node scripts/build-pglite-worker.mjs",
    "build": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win",
    "build:win64": "npm run build:vite && electron-builder --win --x64",
    "build:mac": "npm run build:vite && electron-builder --mac",
    "build:linux": "npm run build:vite && electron-builder --linux",
    "build:all": "npm run build:vite && electron-builder -mwl",
    "build:dir": "npm run build:vite && electron-builder --dir",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "analyze": "electron-vite build -- --mode analyze",
    "analyze:report": "npx vite-bundle-visualizer",
    "perf:startup": "npx tsx scripts/measure-startup.ts",
    "pipeline:test": "npx tsx scripts/run-pipeline-test.ts",
    "codex:fetch": "tsx scripts/fetch-codex.ts",
    "docker-mcp:fetch": "tsx scripts/fetch-docker-mcp.ts",
    "codex:probe": "tsx scripts/probe-codex.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "agent:init-sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/init.sql",
    "prisma:validate": "prisma validate",
    "test:bench": "vitest bench",
    "test:bench:run": "vitest bench --run",
    "test:bench:ci": "vitest bench --run",
    "release": "npm run build:vite && electron-builder --publish always",
    "upload:cos": "node scripts/upload-cos.js",
    "release:cn": "npm run build:win && node scripts/upload-cos.js"
  },
