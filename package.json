{
  "name": "catimation-cyberpunk-master",
  "version": "3.6.0",
  "description": "CATIMATION-Cyberpunk Master - AI图片生成桌面应用",
  "main": "dist/main/index.js",
  "author": "CATIMATION",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:static": "electron . --dev",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:vite": "electron-vite build",
    "build": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win",
    "build:win64": "npm run build:vite && electron-builder --win --x64",
    "build:mac": "npm run build:vite && electron-builder --mac",
    "build:linux": "npm run build:vite && electron-builder --linux",
    "build:all": "npm run build:vite && electron-builder -mwl",
    "build:dir": "npm run build:vite && electron-builder --dir",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "analyze": "electron-vite build -- --mode analyze",
    "analyze:report": "npx vite-bundle-visualizer",
    "perf:startup": "npx tsx scripts/measure-startup.ts",
    "pipeline:test": "npx tsx scripts/run-pipeline-test.ts",
    "test:bench": "vitest bench",
    "test:bench:run": "vitest bench --run",
    "test:bench:ci": "vitest bench --run",
    "release": "npm run build:vite && electron-builder --publish always"
  },
  "dependencies": {
    "@langchain/core": "^1.1.29",
    "@langchain/google": "^0.1.3",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/openai": "^1.2.10",
    "browser-image-compression": "^2.0.2",
    "choices.js": "^11.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "i18next": "^25.8.13",
    "jszip": "^3.10.1",
    "langfuse-langchain": "^3.38.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2799662352/ai-image-master.git"
  },
  "homepage": "https://github.com/2799662352/ai-image-master"
}
